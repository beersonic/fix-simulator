{
    "name": "fix-simulator-electron",
    "version": "0.1.0",
    "description": "Electron wrapper for Fix Simulator (starts local Java backend and shows the web UI)",
    "main": "main.js",
    "scripts": {
        "start": "electron .",
        "dev": "electron .",
        "build": "electron-builder --win --x64",
        "postinstall": "node ./copy-backend-assets.js"
    },
    "author": "Pasagorn P.",
    "license": "MIT",
    "devDependencies": {
        "electron": "^25.0.0",
        "electron-builder": "^26.4.0"
    },
    "build": {
        "appId": "com.beersonic.fixsimulator",
        "productName": "Fix Simulator",
        "directories": {
            "output": "dist"
        },
        "files": [
            "main.js",
            "preload.js",
            "backend/**",
            "runtime/**"
        ],
        "win": {
            "target": [
                {
                    "target": "appx",
                    "arch": ["x64"]
                }
            ]
        },
        "appx": {
            "publisher": "CN=FixSimulatorPublisher",
            "identityName": "FixSimulator",
            "displayName": "Fix Simulator",
            "backgroundColor": "#ffffff"
        }
    }
}
